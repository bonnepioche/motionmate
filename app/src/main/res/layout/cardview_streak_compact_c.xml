<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="@color/bronze_surface"
    app:strokeColor="@color/bronze_primary"
    app:strokeWidth="2dp"
    app:contentPadding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="7dp"
                android:contentDescription="@string/current_streak"
                android:src="@drawable/ic_streak_flame"
                app:tint="@color/bronze_primary" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/textViewDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/bronze_primary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/textViewContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/bronze_on_surface"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="9dp"
                android:background="@color/bronze_outline" />
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="7dp"
                android:contentDescription="@string/best_streak"
                android:src="@drawable/ic_streak_trophy"
                app:tint="@color/bronze_primary" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/best_streak"
                    android:textColor="@color/bronze_primary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/textViewBestStreak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/bronze_on_surface"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <!-- Details reveal on tap, preserving the original record dates and goal. -->
        <TextView
            android:id="@+id/textViewBestPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/bronze_on_surface_variant"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/textViewStreakGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/bronze_on_surface_variant"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
