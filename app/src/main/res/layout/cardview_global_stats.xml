<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/bronze_surface"
    app:strokeColor="@color/bronze_outline" app:strokeWidth="1dp"
    app:contentPadding="0dp">
  <LinearLayout android:id="@+id/globalStatsGradientSurface"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/textViewDescription"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="7dp" android:textColor="@color/bronze_primary"
        android:textStyle="bold" android:textSize="18sp" />
    <!-- Adapter data binding is driven by this hidden live-content view. -->
    <TextView android:id="@+id/textViewContent"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" />
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/bronze_surface_variant"
        app:strokeColor="@color/bronze_outline" app:strokeWidth="1dp">
      <LinearLayout android:id="@+id/globalMonthGradientSurface" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:gravity="center_vertical"
          android:padding="8dp">
        <ImageView android:layout_width="36dp" android:layout_height="36dp"
            android:padding="7dp" android:background="@drawable/bg_stat_icon_bronze"
            android:src="@drawable/ic_stat_calendar" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:orientation="vertical">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="@string/steps_month" android:textColor="@color/bronze_primary"
              android:textSize="12sp" android:maxLines="1" />
          <TextView android:id="@+id/globalMonthValue" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:layout_marginTop="2dp"
              android:textColor="@color/bronze_on_surface" android:textStyle="bold"
              android:textSize="17sp" android:maxLines="1" android:ellipsize="end"
              android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp"
              android:autoSizeMaxTextSize="17sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/bronze_surface_variant"
        app:strokeColor="@color/bronze_outline" app:strokeWidth="1dp">
      <LinearLayout android:id="@+id/globalAverageGradientSurface" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:gravity="center_vertical"
          android:padding="8dp">
        <ImageView android:layout_width="36dp" android:layout_height="36dp"
            android:padding="7dp" android:background="@drawable/bg_stat_icon_bronze"
            android:src="@drawable/ic_stat_average" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:orientation="vertical">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="@string/avg_distance" android:textColor="@color/bronze_primary"
              android:textSize="12sp" android:maxLines="1" />
          <TextView android:id="@+id/globalAverageValue" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:layout_marginTop="2dp"
              android:textColor="@color/bronze_on_surface" android:textStyle="bold"
              android:textSize="17sp" android:maxLines="1" android:ellipsize="end"
              android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp"
              android:autoSizeMaxTextSize="17sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/bronze_surface_variant"
        app:strokeColor="@color/bronze_outline" app:strokeWidth="1dp">
      <LinearLayout android:id="@+id/globalOverallGradientSurface" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:gravity="center_vertical"
          android:padding="8dp">
        <ImageView android:layout_width="36dp" android:layout_height="36dp"
            android:padding="7dp" android:background="@drawable/bg_stat_icon_bronze"
            android:src="@drawable/ic_stat_total" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:orientation="vertical">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="@string/overall_distance" android:textColor="@color/bronze_primary"
              android:textSize="12sp" android:maxLines="1" />
          <TextView android:id="@+id/globalOverallValue" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:layout_marginTop="2dp"
              android:textColor="@color/bronze_on_surface" android:textStyle="bold"
              android:textSize="17sp" android:maxLines="1" android:ellipsize="end"
              android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp"
              android:autoSizeMaxTextSize="17sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
