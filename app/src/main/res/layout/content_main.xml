<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bronze_background"
    android:paddingBottom="84dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- Steps and distance counter: large icon left, responsive text right. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bronze_surface"
            app:strokeColor="@color/bronze_outline"
            app:strokeWidth="1dp"
            app:contentPadding="0dp">
            <LinearLayout android:id="@+id/todayGradientSurface" android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <!-- Square viewport prevents the winding path from being cropped. -->
                <com.tiefensuche.motionmate.ui.GoalProgressView
                    android:id="@+id/goalProgress"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:importantForAccessibility="yes" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/today_label"
                        android:textColor="@color/bronze_on_surface_variant"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/textViewSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/bronze_on_surface"
                        android:textStyle="bold"
                        android:textSize="28sp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="18sp"
                        android:autoSizeMaxTextSize="28sp"
                        android:autoSizeStepGranularity="1sp" />
                    <TextView
                        android:id="@+id/textViewMeters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/bronze_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textViewGoalProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/bronze_on_surface_variant"
                        android:textSize="12sp"
                        android:maxLines="2" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Current Streak: directly after today's steps and before History.
             The adapter preserves Current / Compact B / Compact C styles. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewStreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- Week / Balanced B: compact copper chart + goal + three summary KPIs. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="310dp"
            android:layout_margin="3dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bronze_surface"
            app:strokeColor="@color/bronze_outline"
            app:strokeWidth="1dp"
            app:contentPadding="0dp">
            <LinearLayout android:id="@+id/weekGradientSurface" android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/textViewChart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bronze_primary"
                    android:textSize="17sp" />
                <TextView
                    android:id="@+id/textViewWeekGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/bronze_on_surface_variant"
                    android:textSize="11sp" />
                <com.tiefensuche.motionmate.ui.Chart
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bronze_outline" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/week_total_label"
                            android:textColor="@color/bronze_on_surface_variant"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/textViewWeekTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/bronze_on_surface"
                            android:textStyle="bold"
                            android:textSize="18sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/week_average_label"
                            android:textColor="@color/bronze_on_surface_variant"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/textViewWeekAverage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/bronze_on_surface"
                            android:textStyle="bold"
                            android:textSize="18sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/week_goal_days_label"
                            android:textColor="@color/bronze_on_surface_variant"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/textViewWeekAchieved"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/bronze_primary"
                            android:textStyle="bold"
                            android:textSize="17sp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/textViewWeekHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:textColor="@color/bronze_on_surface_variant"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- History dev.12: compact daily summary and optional analytical month grid. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bronze_surface"
            app:strokeColor="@color/bronze_outline"
            app:strokeWidth="1dp"
            app:contentPadding="0dp">
            <LinearLayout android:id="@+id/historyGradientSurface" android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/history"
                        android:textColor="@color/bronze_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textViewCalendarToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:minWidth="112dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/history_show_calendar"
                        android:textColor="@color/bronze_primary"
                        android:textSize="13sp" />
                </LinearLayout>
                <!-- Date navigation stays visible while the month grid is collapsed. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/historyPreviousDay"
                        android:layout_width="44dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/history_previous_day"
                        android:background="?attr/selectableItemBackground"
                        android:text="‹"
                        android:textColor="@color/bronze_primary"
                        android:textSize="27sp" />
                    <TextView
                        android:id="@+id/textViewHistoryDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/bronze_on_surface"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/historyNextDay"
                        android:layout_width="44dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/history_next_day"
                        android:background="?attr/selectableItemBackground"
                        android:text="›"
                        android:textColor="@color/bronze_primary"
                        android:textSize="27sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="0dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/history_walking_icon"
                        app:srcCompat="@drawable/ic_history_walk_bronze" />
                    <TextView
                        android:id="@+id/textViewHistorySteps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="8dp"
                        android:textColor="@color/bronze_on_surface"
                        android:textStyle="bold"
                        android:textSize="28sp" />
                    <TextView
                        android:id="@+id/textViewHistoryPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/bronze_primary"
                        android:textStyle="bold"
                        android:textSize="22sp" />
                </LinearLayout>
                <com.tiefensuche.motionmate.ui.HistoryGoalBarView
                    android:id="@+id/historyGoalProgress"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="7dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textViewHistoryDistance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/bronze_on_surface_variant"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/textViewHistoryStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/bronze_primary"
                        android:textSize="12sp" />
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/calendarContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">
                    <com.tiefensuche.motionmate.ui.HistoryCalendarView
                        android:id="@+id/historyCalendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
